# Supabase — Project Settings → API (use your HOSTED project for Vercel)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER expose to the browser or commit to git.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App — set to your deployed URL on Vercel (http://localhost:3000 locally)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The single admin account — auto-promoted (admin + verified) on first sign-in
ADMIN_EMAIL=you@bennett.edu.in

# Email notifications. Resend key: https://resend.com/api-keys. The sender
# must be on a domain you verified in Resend (onboarding@resend.dev works for
# testing, but only delivers to your own Resend account email).
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=BorrowBuddy <notifications@borrowbuddy.app>
# Random 32+ characters. The database scheduler sends it to
# /api/cron/notification-emails; store the same value in Supabase Vault as
# borrowbuddy_cron_secret (see supabase/migrations/*_notification_email.sql).
CRON_SECRET=

# Buddy assistant (optional). Free keys: https://aistudio.google.com/apikey
# and https://console.groq.com/keys. With no key, Buddy runs its local brain
# (policy answers + live catalog/account lookups, no free-form AI).
ASSISTANT_PROVIDER=          # gemini | groq | local (default: first key present)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
