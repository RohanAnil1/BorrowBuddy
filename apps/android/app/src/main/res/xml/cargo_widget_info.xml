<?xml version="1.0" encoding="utf-8"?>
<!-- 4x2 boarding pass. Resizes down to 2x2 and up to 4x3+; CargoWidget picks the layout.
     WorkManager refreshes it (hourly, and when the app is left), so no updatePeriodMillis. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_pass_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="230dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:previewImage="@drawable/widget_logo"
    android:previewLayout="@layout/widget_preview_wide"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
