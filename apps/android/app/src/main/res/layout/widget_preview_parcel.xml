<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview for the 2x2 Parcel widget (static sample data). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_canvas"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="8dp"
    tools:ignore="HardcodedText,SmallSp,ContentDescription">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_ticket"
        android:orientation="vertical"
        android:paddingStart="9dp"
        android:paddingTop="7dp"
        android:paddingEnd="9dp"
        android:paddingBottom="7dp">
        <TextView style="@style/WidgetPreview.Mono" android:text="[ ALL CLEAR ]" android:textColor="#47d18a" android:textSize="7.5sp" />
        <TextView style="@style/WidgetPreview.Title" android:layout_marginTop="2dp" android:maxLines="2" android:text="NOTHING DUE" android:textSize="15sp" />
    </LinearLayout>

    <ImageView android:layout_width="14dp" android:layout_height="7dp" android:src="@drawable/widget_bubble_tail_down" android:contentDescription="@null" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_parcel" />
</LinearLayout>
