<?xml version="1.0" encoding="utf-8"?>
<!-- Styles for the widget picker previews only; the live widget sets these in code. -->
<resources>
    <style name="WidgetPreview" />
    <style name="WidgetPreview.Mono">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/noto_mono</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="WidgetPreview.Title" parent="WidgetPreview.Mono">
        <item name="android:fontFamily">@font/noto_condensed</item>
        <item name="android:textColor">#ffffff</item>
    </style>
    <style name="WidgetPreview.Tile" parent="WidgetPreview.Mono">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/widget_tile</item>
        <item name="android:maxLines">2</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textColor">#ff9f00</item>
        <item name="android:textSize">10sp</item>
    </style>
    <style name="WidgetPreview.Pill" parent="WidgetPreview.Mono">
        <item name="android:layout_height">24dp</item>
        <item name="android:background">@drawable/widget_pill</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">9sp</item>
    </style>
    <style name="WidgetPreview.Dot">
        <item name="android:layout_width">3dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:scaleType">center</item>
        <item name="android:src">@drawable/widget_dot</item>
        <item name="android:contentDescription">@null</item>
    </style>
</resources>
