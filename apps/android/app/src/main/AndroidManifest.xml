<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application
        android:name=".BorrowBuddyApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="BorrowBuddy"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.BorrowBuddy"
        android:usesCleartextTraffic="false">
        <!-- Ask Play services to fetch Google's QR scanner UI ahead of the first scan. -->
        <meta-data android:name="com.google.mlkit.vision.DEPENDENCIES" android:value="barcode_ui" />
        <activity android:name=".MainActivity" android:exported="true" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Home-screen widget: a 4x2 boarding pass and a 2x2 pocket pass, both CargoWidget. -->
        <receiver android:name=".widget.CargoWidgetReceiver" android:exported="true" android:label="@string/widget_pass_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/cargo_widget_info" />
        </receiver>
        <receiver android:name=".widget.CargoWidgetSmallReceiver" android:exported="true" android:label="@string/widget_small_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/cargo_widget_small_info" />
        </receiver>
        <receiver android:name=".widget.ParcelWidgetReceiver" android:exported="true" android:label="@string/widget_parcel_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/parcel_widget_info" />
        </receiver>
    </application>
</manifest>
